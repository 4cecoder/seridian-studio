# Seridian: ravenc (Zig, tools/ravenc/ravenc.zig) against the C program it translates
# (deprecated-c/tools/ravenc/ravenc.c). Every .xml / .xmlc* / .xml<lang> file of Raven, plus the edge cases and
# the errors of tools/ravenc/tests, is compiled by both, in every language: the output files must be the same
# bytes, and the messages and the exit status the same.
#
#   cmake -DZIG_RAVENC=<zig ravenc> -DC_RAVENC=<C ravenc> -DRAVEN_DIR=<vendor/raven> -DWORK_DIR=<dir> -P compare.cmake

foreach(_var ZIG_RAVENC C_RAVENC RAVEN_DIR WORK_DIR)
	if(NOT DEFINED ${_var})
		message(FATAL_ERROR "compare.cmake: -D${_var}=... is required")
	endif()
endforeach()

file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")

set(_patterns "*.xml" "*.xmlc" "*.xmlc++" "*.xmlcpp" "*.xmlrs" "*.xmlpy" "*.xmlgo" "*.xmlcs" "*.xmlzig" "*.xmllua")
set(_inputs "")
foreach(_dir examples tests bindings tools/ravenc/tests)
	foreach(_pattern IN LISTS _patterns)
		file(GLOB_RECURSE _found RELATIVE "${RAVEN_DIR}" "${RAVEN_DIR}/${_dir}/${_pattern}")
		list(APPEND _inputs ${_found})
	endforeach()
endforeach()
list(REMOVE_DUPLICATES _inputs)
list(SORT _inputs)
list(LENGTH _inputs _input_count)
if(_input_count LESS 20)
	message(FATAL_ERROR "compare.cmake: only ${_input_count} inputs found under ${RAVEN_DIR}")
endif()

# "" = the language of the extension; then each language, and a --name
set(_variants "-" "c" "cpp" "rust" "python" "go" "csharp" "zig" "lua" "name")
set(_runs 0)
set(_failures 0)
set(_index 0)
foreach(_input IN LISTS _inputs)
	math(EXPR _index "${_index} + 1")
	foreach(_variant IN LISTS _variants)
		set(_args "")
		if(_variant STREQUAL "name")
			set(_args --name renamed_unit)
		elseif(NOT _variant STREQUAL "-")
			set(_args --lang ${_variant})
		endif()
		# the same output path for both: it is written into the output (#line), like the input path
		set(_out "${WORK_DIR}/${_index}.${_variant}.out")
		set(_zig_out "${WORK_DIR}/${_index}.${_variant}.zig.out")
		set(_c_out "${WORK_DIR}/${_index}.${_variant}.c.out")
		execute_process(COMMAND "${ZIG_RAVENC}" "${_input}" -o "${_out}" ${_args}
			WORKING_DIRECTORY "${RAVEN_DIR}" RESULT_VARIABLE _zig_status OUTPUT_VARIABLE _zig_stdout ERROR_VARIABLE _zig_stderr)
		if(EXISTS "${_out}")
			file(RENAME "${_out}" "${_zig_out}")
		endif()
		execute_process(COMMAND "${C_RAVENC}" "${_input}" -o "${_out}" ${_args}
			WORKING_DIRECTORY "${RAVEN_DIR}" RESULT_VARIABLE _c_status OUTPUT_VARIABLE _c_stdout ERROR_VARIABLE _c_stderr)
		if(EXISTS "${_out}")
			file(RENAME "${_out}" "${_c_out}")
		endif()
		math(EXPR _runs "${_runs} + 1")
		set(_why "")
		if(NOT _zig_status STREQUAL _c_status)
			set(_why "exit status ${_zig_status} (Zig) vs ${_c_status} (C)")
		elseif(NOT _zig_stderr STREQUAL _c_stderr)
			set(_why "messages differ:\n  Zig: ${_zig_stderr}  C:   ${_c_stderr}")
		elseif(NOT _zig_stdout STREQUAL _c_stdout)
			set(_why "standard output differs")
		elseif(EXISTS "${_c_out}" OR EXISTS "${_zig_out}")
			if(NOT EXISTS "${_c_out}" OR NOT EXISTS "${_zig_out}")
				set(_why "only one of them wrote the output")
			else()
				execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${_zig_out}" "${_c_out}" RESULT_VARIABLE _same)
				if(NOT _same EQUAL 0)
					set(_why "the outputs differ: ${_zig_out} ${_c_out}")
				endif()
			endif()
		endif()
		if(_why)
			math(EXPR _failures "${_failures} + 1")
			message(SEND_ERROR "ravenc ${_input} ${_args}: ${_why}")
		endif()
	endforeach()
endforeach()

# the command line itself
foreach(_case "--help" "-x" "only_input.xmlc" "a.xmlc|-o|b|c")
	string(REPLACE "|" ";" _args "${_case}")
	execute_process(COMMAND "${ZIG_RAVENC}" ${_args} WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE _zig_status ERROR_VARIABLE _zig_stderr)
	execute_process(COMMAND "${C_RAVENC}" ${_args} WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE _c_status ERROR_VARIABLE _c_stderr)
	math(EXPR _runs "${_runs} + 1")
	if(NOT _zig_status STREQUAL _c_status OR NOT _zig_stderr STREQUAL _c_stderr)
		math(EXPR _failures "${_failures} + 1")
		message(SEND_ERROR "ravenc ${_case}: status ${_zig_status} vs ${_c_status}, messages:\n${_zig_stderr}\n${_c_stderr}")
	endif()
endforeach()
foreach(_case "missing_file.xmlc|-o|out.c" "${RAVEN_DIR}/tools/ravenc/tests/9lives.xmlc|-o|out.c|--lang|cobol"
		"${RAVEN_DIR}/tools/ravenc/tests/9lives.xmlc|-o|out.c|--name|9bad" "${RAVEN_DIR}/tools/ravenc/tests/9lives.xmlc|-o|no/such/dir/out.c")
	string(REPLACE "|" ";" _args "${_case}")
	execute_process(COMMAND "${ZIG_RAVENC}" ${_args} WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE _zig_status ERROR_VARIABLE _zig_stderr)
	execute_process(COMMAND "${C_RAVENC}" ${_args} WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE _c_status ERROR_VARIABLE _c_stderr)
	math(EXPR _runs "${_runs} + 1")
	if(NOT _zig_status STREQUAL _c_status OR NOT _zig_stderr STREQUAL _c_stderr)
		math(EXPR _failures "${_failures} + 1")
		message(SEND_ERROR "ravenc ${_case}: status ${_zig_status} vs ${_c_status}, messages:\n${_zig_stderr}\n${_c_stderr}")
	endif()
endforeach()

if(_failures GREATER 0)
	message(FATAL_ERROR "ravenc: ${_failures} of ${_runs} runs differ from the C program")
endif()
message(STATUS "ravenc: ${_runs} runs (${_input_count} inputs), Zig and C identical")
